{
    "name": "@adkit/meta-pixel",
    "version": "1.2.1",
    "description": "Meta (Facebook) Pixel for JavaScript and TypeScript. Type-safe fbevents.js wrapper with eager, lazy, and manual script loading, event deduplication, and multiple pixels.",
    "homepage": "https://adkit.so",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/adkit/conversion-tracking.git",
        "directory": "packages/js/meta-pixel"
    },
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "unbuild",
        "test": "npm run build && node --test test/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "prepack": "npm run build",
        "test:watch": "node --test --watch test/*.test.mjs"
    },
    "keywords": [
        "meta-pixel",
        "facebook-pixel",
        "meta",
        "facebook",
        "pixel",
        "conversion-tracking",
        "tracking",
        "analytics",
        "typescript",
        "javascript"
    ],
    "author": "",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "typescript": "^5.3.3",
        "unbuild": "^2.0.0"
    }
}
