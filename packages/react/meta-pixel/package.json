{
  "name": "@adkit/meta-pixel-react",
  "version": "1.1.1",
  "description": "Meta (Facebook) Pixel for React. Provider and hook with type-safe events, Conversions API deduplication, and lazy script loading.",
  "homepage": "https://adkit.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adkit/conversion-tracking.git",
    "directory": "packages/react/meta-pixel"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "dev": "cd playground && npm run dev",
    "prepack": "npm run build",
    "lint": "echo 'No linting configured'",
    "test": "npm run test:unit",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "test:ui": "playwright test --config test/playwright.config.ts --ui",
    "test:unit": "vitest run --config test/vitest.config.ts",
    "test:unit:watch": "vitest watch --config test/vitest.config.ts"
  },
  "keywords": [
    "meta-pixel",
    "facebook-pixel",
    "react-facebook-pixel",
    "meta",
    "facebook",
    "pixel",
    "conversion-tracking",
    "tracking",
    "analytics",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@adkit/meta-pixel": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "happy-dom": "^12.10.3",
    "playwright-core": "^1.56.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "unbuild": "^2.0.0",
    "vitest": "^1.0.4"
  }
}
